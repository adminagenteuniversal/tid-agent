rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función auxiliar para verificar si el usuario es dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // 1. Colección de Identidades del Agente (Voz, Perfiles, Habilidades, Ecosistemas)
    // El cerebro central: los visitantes y el panel administrador leen las identidades.
    match /identidades/{identidadId} {
      allow read: if true; // Lectura pública para que los visitantes en web/apk puedan interactuar
      allow write: if isAuthenticated(); // Edición y creación desde el Panel Administrador
    }
    
    // 2. Colección de Entrevistas y Expedientes
    // Cada sesión se almacena con número de expediente y número de seguimiento
    match /entrevistas/{entrevistaId} {
      allow read: if isAuthenticated() && (
        resource.data.usuarioId == request.auth.uid ||
        request.auth.token.admin == true
      );
      allow create: if isAuthenticated() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.usuarioId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.usuarioId == request.auth.uid ||
        request.auth.token.admin == true
      );
    }
    
    // 3. Colección de Estadísticas Semanales
    match /estadisticas_semanales/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
